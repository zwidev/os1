{
  "id": "local-inference",
  "type": "inference",
  "name": "Ollama (local embeddings + fallback)",
  "version": "0.1.0",
  "summary": "Local Ollama server. Provides free embeddings for semantic memory recall and an optional offline LLM fallback.",
  "installScript": "install.sh",
  "required": false,
  "models": [
    { "name": "nomic-embed-text", "role": "embeddings" },
    { "name": "qwen2.5:7b", "role": "fallback-chat", "optional": true }
  ],
  "ports": [{ "port": 11434, "proto": "http", "role": "ollama", "bind": "loopback" }],
  "healthCheck": { "url": "http://127.0.0.1:11434/api/tags", "expectStatus": 200 },
  "resourceHints": { "minMemoryMb": 4096, "gpuOptional": true }
}
