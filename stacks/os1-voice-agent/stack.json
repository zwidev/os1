{
  "schemaVersion": 1,
  "id": "os1-voice-agent",
  "name": "OS1 Voice Agent",
  "version": "0.1.0",
  "summary": "Real-time voice AI. ElevenLabs voice talks to Claude for fast, natural conversation; an OpenClaw agent performs file/code/system tasks in the background; persistent Obsidian-backed memory recalls context across sessions.",
  "reviewStatus": "review",
  "deploymentProfile": "openclaw-claude-elevenlabs-obsidian",
  "components": [
    {
      "id": "agent-gateway",
      "type": "runtime",
      "path": "components/agent-gateway",
      "installOrder": 10,
      "required": true,
      "notes": "OpenClaw gateway (agent/tools host) + the voice proxy that splits fast conversation from background task execution."
    },
    {
      "id": "primary-llm",
      "type": "inference-provider",
      "provider": "anthropic",
      "configRef": "components/agent-gateway/config.template.json",
      "credentialIds": ["primary_llm_api_key"],
      "installOrder": 20,
      "required": true,
      "notes": "Claude via the Anthropic API. Powers both the fast talking layer and the OpenClaw worker."
    },
    {
      "id": "local-inference",
      "type": "inference",
      "path": "components/local-inference",
      "installOrder": 30,
      "required": false,
      "notes": "Ollama for local embeddings (semantic memory recall) and optional offline LLM fallback."
    },
    {
      "id": "memory-vault",
      "type": "data",
      "path": "components/memory-vault",
      "installOrder": 40,
      "required": true,
      "notes": "OpenClaw builtin memory backend + memory-wiki Obsidian vault + nightly Dreaming consolidation."
    },
    {
      "id": "voice-channel",
      "type": "integration",
      "path": "components/voice-channel",
      "credentialIds": ["elevenlabs_api_key", "elevenlabs_agent_id"],
      "installOrder": 50,
      "required": true,
      "notes": "ElevenLabs Conversational AI agent. Points its custom-llm Server URL at this tenant's gateway."
    },
    {
      "id": "os1-dashboard",
      "type": "dashboard",
      "path": "components/os1-dashboard",
      "installOrder": 60,
      "required": true,
      "notes": "OS1 React UI for starting/holding the voice conversation."
    }
  ],
  "services": [
    { "id": "agent-gateway", "unit": "agent-gateway.service", "componentId": "agent-gateway" },
    { "id": "voice-proxy", "unit": "voice-proxy.service", "componentId": "agent-gateway" }
  ],
  "entrypoints": {
    "setupUrl": "/",
    "dashboardUrl": "/",
    "primaryPort": 18789
  },
  "requiredCredentials": [
    { "id": "primary_llm_api_key", "label": "Anthropic API key", "requiredFor": "cloud inference" },
    { "id": "elevenlabs_api_key", "label": "ElevenLabs API key", "requiredFor": "voice synthesis and agent configuration" },
    { "id": "elevenlabs_agent_id", "label": "ElevenLabs Agent ID", "requiredFor": "voice channel" }
  ],
  "resourceHints": { "minMemoryMb": 4096, "gpuOptional": true },
  "exportPolicy": {
    "excludeSecrets": true,
    "excludePrivateMemory": true,
    "excludeCustomerData": true
  }
}
